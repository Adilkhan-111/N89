  _sleepDuration: 4
  _closeZoom: 3
  _roamZoom: 5
  _bathroomObjective: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u0432\u0430\u043D\u043D\u0443\u044E"
  _arsenalObjective: "\u0418\u0434\u0438 \u0432 \u0430\u0440\u0441\u0435\u043D\u0430\u043B"
  _arsenalZone: {fileID: 704805844}
  _arsenal: {fileID: 1577578005}
  _mission: 1
  _bathroomZone: {fileID: 1484851761}
  _messenger: {fileID: 1746825824}
  _messageCamPoint: {fileID: 1144699241}
  _bossName: "\u0411\u041E\u0421\u0421"
  _briefingTopic: "\u0417\u0410\u0414\u0410\u041D\u0418\u0415: \u041B\u041E\u0413\u041E\u0412\u041E \u0411\u0410\u041D\u0414\u042B"
  _briefing:
  - "\u0420\u044D\u0439. \u0415\u0441\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u0430."
  - "\u041E\u0434\u043D\u0430 \u0443\u043B\u0438\u0447\u043D\u0430\u044F \u0431\u0430\u043D\u0434\u0430 \u0443\u0436\u0435 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u0433\u0440\u0430\u0431\u0438\u0442 \u0438 \u0433\u0440\u043E\u043C\u0438\u0442 \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 \u0415. \u0421\u043A\u043B\u0430\u0434\u044B, \u043A\u043E\u043D\u0432\u043E\u0438, \u0432\u0441\u0451, \u0434\u043E \u0447\u0435\u0433\u043E \u0434\u043E\u0442\u044F\u043D\u0435\u0442\u0441\u044F."
  - "\u041D\u0430\u0432\u0435\u0440\u0445\u0443 \u044D\u0442\u043E \u043D\u0430\u0434\u043E\u0435\u043B\u043E. \u041F\u043E\u0439\u0434\u0451\u0448\u044C \u0432 \u0438\u0445 \u043B\u043E\u0433\u043E\u0432\u043E \u0438 \u0443\u0431\u0435\u0440\u0451\u0448\u044C \u0432\u0441\u0435\u0445. \u0411\u0435\u0437 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439."
  - "\u041C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u2014 \u0432 \u0444\u0430\u0439\u043B\u0435. \u041D\u0435 \u043F\u043E\u0434\u0432\u0435\u0434\u0438."
  _briefingFile: "\u041B\u041E\u0413\u041E\u0412\u041E_\u0411\u0410\u041D\u0414\u042B.loc"
