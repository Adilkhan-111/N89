  _loading: {fileID: 1581457913}
  _doorObjective: "\u0418\u0434\u0438 \u043A \u0434\u0432\u0435\u0440\u0438"
  _leaveObjective: "\u0412\u044B\u0439\u0434\u0438 \u0438\u0437 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430"
  _missionScene: Mission02
  _missionTitle: "\u041C\u0418\u0421\u0421\u0418\u042F 2"
  _missionSubtitle: "\u0410\u0420\u041A\u0410 \u0421\u0418\u0421\u0422\u0415\u041C\u0421  //  \u0417\u0410\u0411\u0420\u0410\u0422\u042C \u041A\u0415\u0419\u0421 \u0421 \u041A\u041E\u041C\u041F\u0420\u041E\u041C\u0410\u0422\u041E\u041C"
  _bathroomZone: {fileID: 682561548}
  _messenger: {fileID: 1925746900}
  _messageCamPoint: {fileID: 1540250351}
  _bossName: "\u041E\u041F\u0415\u0420\u0410\u0422\u041E\u0420"
  _briefingTopic: "\u0417\u0410\u0414\u0410\u041D\u0418\u0415: \u041A\u0415\u0419\u0421 \u0421 \u041A\u041E\u041C\u041F\u0420\u041E\u041C\u0410\u0422\u041E\u041C"
  _briefing:
  - "\u0420\u044D\u0439. \xAB\u0410\u0440\u043A\u0430 \u0421\u0438\u0441\u0442\u0435\u043C\u0441\xBB \u0441\u043E\u0431\u0440\u0430\u043B\u0430 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442 \u043D\u0430 \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044E \u0415."
  - "\u0412\u0441\u0451 \u043B\u0435\u0436\u0438\u0442 \u0432 \u044D\u0442\u043E\u043C \u043A\u0435\u0439\u0441\u0435. \u041D\u0430\u0439\u0434\u0438 \u0435\u0433\u043E \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0438. \u0411\u0435\u0437 \u043A\u0435\u0439\u0441\u0430 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F."
  _briefingFile: "\u0410\u0420\u041A\u0410_\u0421\u0418\u0421\u0422\u0415\u041C\u0421.loc"
  _briefingPhoto: {fileID: 21300000, guid: 1e1266ed1067e084da28ffcc7053f8b4, type: 3}
  _briefingPhotoCaption: "\u0426\u0415\u041B\u042C: \u041A\u0415\u0419\u0421\n\u0421 \u041A\u041E\u041C\u041F\u0420\u041E\u041C\u0410\u0422\u041E\u041C\n\n\u0412\u0435\u0441\u044C \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442 \u043D\u0430 \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044E \u0415 \u2014 \u0432\u043D\u0443\u0442\u0440\u0438.\n\n\u0414\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0446\u0435\u043B\u044B\u043C. \u041D\u0435 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C."
