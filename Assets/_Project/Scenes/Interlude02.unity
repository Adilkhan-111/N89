  _bathroomObjective: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u0432\u0430\u043D\u043D\u0443\u044E"
  _arsenalObjective: "\u0418\u0434\u0438 \u0432 \u0430\u0440\u0441\u0435\u043D\u0430\u043B"
  _arsenalZone: {fileID: 335689355}
