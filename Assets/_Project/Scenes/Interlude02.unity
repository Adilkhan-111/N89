  _loading: {fileID: 631819300}
  _doorObjective: "\u0418\u0434\u0438 \u043A \u0434\u0432\u0435\u0440\u0438"
  _leaveObjective: "\u0412\u044B\u0439\u0434\u0438 \u0438\u0437 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430"
  _missionScene: Mission02
  _missionTitle: "\u041C\u0418\u0421\u0421\u0418\u042F 2"
  _missionSubtitle: "\u0410\u0420\u041A\u0410 \u0421\u0418\u0421\u0422\u0415\u041C\u0421  //  \u0414\u041E\u0411\u042B\u0422\u042C \u041A\u041E\u041C\u041F\u0420\u041E\u041C\u0410\u0422"
  _bathroomZone: {fileID: 868559848}
  _messenger: {fileID: 489316188}
  _messageCamPoint: {fileID: 742031521}
  _bossName: "\u0411\u041E\u0421\u0421"
  _briefingTopic: "\u0417\u0410\u0414\u0410\u041D\u0418\u0415: \u041A\u041E\u041C\u041F\u0420\u041E\u041C\u0410\u0422"
  _briefing:
  - "\u0420\u044D\u0439. \u0415\u0441\u0442\u044C \u0434\u0435\u043B\u043E."
  - "\xAB\u0410\u0440\u043A\u0430 \u0421\u0438\u0441\u0442\u0435\u043C\u0441\xBB, \u0434\u043E\u0447\u043A\u0430 \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u043C\u043E\u043D\u043E\u043F\u043E\u043B\u0438\u0441\u0442\u0430 \u0441\u0438\u043D\u0435\u0439 \u043A\u0440\u043E\u0432\u0438, \u043A\u043E\u043F\u0430\u0435\u0442 \u043F\u043E\u0434 \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044E \u0415. \u041D\u0443\u0436\u0435\u043D \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442 \u0441 \u0438\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u0432."
  - "\u0417\u0434\u0430\u043D\u0438\u0435 \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0433\u043E\u0440\u043E\u0434\u0430. \u041D\u0430 \u0432\u0438\u0434 \u2014 \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u043E\u0444\u0438\u0441, \u043D\u043E \u0437\u0430\u0449\u0438\u0442\u0430 \u0442\u0430\u043C \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435, \u0447\u0435\u043C \u0443 \u043D\u0430\u0441 \u0432 \u0448\u0442\u0430\u0431\u0435."
  - "\u041C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u2014 \u0432 \u0444\u0430\u0439\u043B\u0435. \u0418, \u0420\u044D\u0439... \u0447\u0442\u043E \u0431\u044B \u0442\u044B \u0442\u0430\u043C \u043D\u0438 \u0443\u0432\u0438\u0434\u0435\u043B \u2014 \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0439\u0441\u044F."
  _briefingFile: "\u0410\u0420\u041A\u0410_\u0421\u0418\u0421\u0422\u0415\u041C\u0421.loc"
  _fader: {fileID: 1179871488}
  _objective: {fileID: 1878223018}
  _crosshair: {fileID: 1158372704}
  _letterboxTop: {fileID: 1754623102}
  _letterboxBottom: {fileID: 543957656}
