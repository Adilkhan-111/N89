  _loading: {fileID: 638543876}
  _doorObjective: "\u0418\u0434\u0438 \u043A \u0434\u0432\u0435\u0440\u0438"
  _elevatorDoor: {fileID: 1430286716}
  _elevatorZone: {fileID: 978719248}
  _cabZone: {fileID: 707428177}
  _streetSpawn: {fileID: 1789686424}
  _streetDoor: {fileID: 1739924566}
  _car: {fileID: 723773608}
  _carReach: 1.9
  _elevatorObjective: "\u0418\u0434\u0438 \u043A \u043B\u0438\u0444\u0442\u0443"
  _carObjective: "\u0421\u044F\u0434\u044C \u0432 \u043C\u0430\u0448\u0438\u043D\u0443"
  _missionScene: Mission03
  _missionTitle: "\u041C\u0418\u0421\u0421\u0418\u042F 3"
  _missionSubtitle: "\u0410\u0420\u041A\u0410 \u0421\u0418\u0421\u0422\u0415\u041C\u0421  //  \u0417\u0410\u0411\u0420\u0410\u0422\u042C \u0420\u0415\u041B\u0418\u041A\u0412\u0418\u042E, \u0423\u0411\u0418\u0422\u042C \u0412\u0421\u0415\u0425"
  _bathroomZone: {fileID: 1951171605}
  _messenger: {fileID: 1879028592}
  _messageCamPoint: {fileID: 637595188}
  _bossName: "\u0411\u041E\u0421\u0421"
  _briefingTopic: "\u0417\u0410\u0414\u0410\u041D\u0418\u0415: \u0420\u0415\u041B\u0418\u041A\u0412\u0418\u042F"
  _briefing:
  - "\u0420\u044D\u0439. \u0420\u0430\u0431\u043E\u0442\u0430. \u0421\u0430\u043C\u0430\u044F \u0432\u0430\u0436\u043D\u0430\u044F \u0438\u0437 \u0432\u0441\u0435\u0445, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0431\u044B\u043B\u0438."
  - "\xAB\u0410\u0440\u043A\u0430 \u0421\u0438\u0441\u0442\u0435\u043C\u0441\xBB \u2014 \u0434\u043E\u0447\u043A\u0430 \u043D\u0430\u0448\u0438\u0445 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432 \u2014 \u0434\u043E\u0441\u0442\u0430\u043B\u0430 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E. \u0412\u043D\u0443\u0442\u0440\u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442. \u0427\u0435\u0439 \u2014 \u043D\u0435 \u0437\u043D\u0430\u0435\u043C \u0434\u0430\u0436\u0435 \u043C\u044B."
  - "\u0420\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0432 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438, \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u044D\u0442\u0430\u0436\u0435 \u0438\u0445 \u0431\u0430\u0448\u043D\u0438. \u0427\u0435\u0442\u044B\u0440\u0435 \u044D\u0442\u0430\u0436\u0430 \u043E\u0445\u0440\u0430\u043D\u044B, \u043A\u0430\u043C\u0435\u0440 \u0438 \u0434\u0440\u043E\u043D\u043E\u0432. \u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u0439 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0439."
  - "\u0412\u0437\u043B\u043E\u043C \u0442\u0430\u043C \u043D\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442. \u0412 \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u0435 \u0442\u0435\u0431\u044F \u0436\u0434\u0451\u0442 \u0421\u0430\u043D\u0434\u0435\u0432\u0438\u0441\u0442\u0430\u043D. \u041D\u0435 \u0441\u0433\u043E\u0440\u0438."
  _briefingFile: "\u0410\u0420\u041A\u0410_\u0421\u0418\u0421\u0422\u0415\u041C\u0421.loc"
  _briefingPhoto: {fileID: 0}
  _briefingPhotoCaption: 
