  _banner: {fileID: 64931111}
  _waypoint: {fileID: 909268944}
  _implantTitle: "\u0420\u0423\u041A\u0418 \u0413\u041E\u0420\u0418\u041B\u041B\u042B"
  _implantHint: "\u041F\u041A\u041C \u2014 \u0420\u042B\u0412\u041E\u041A \u0421 \u0423\u0414\u0410\u0420\u041E\u041C   \xB7   \u0417\u0410\u0416\u0410\u0422\u042C \u041F\u041A\u041C \u2014 \u0411\u041B\u041E\u041A"
  _stairsText: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0441\u044C \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436"
  _floor2Text: "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445, \u043A\u0440\u043E\u043C\u0435 \u0446\u0435\u043B\u0438"
  _officeText: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0446\u0435\u043B\u0438"
  _checkpoint: mission01_floor2
  _target: {fileID: 1044039335}
  _targetBody: {fileID: 1831948178}
  _targetStanding: {fileID: 21300000, guid: ba150085c23f19542bd5600e3bbca0d9, type: 3}
  _targetDead: {fileID: 21300000, guid: f2d7ccfa47e24b2448cef8f240d6649a, type: 3}
  _deskPoint: {x: 78.66, y: 2.64}
  _bloodFxPrefab: {fileID: 3303843078949948053, guid: 4aaf74fecc522194181c8f036ba46984, type: 3}
  _bloodPoolPrefab: {fileID: 6376225218116221651, guid: 1454d25959de99249b787f210a6f4293, type: 3}
  _targetLines:
  - "\u0421\u0442\u043E\u0439... \u0421\u0442\u043E\u0439! \u041A\u0442\u043E \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0441\u043B\u0430\u043B?"
  - "\u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F? \u042F \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435!"
  _fader: {fileID: 760060348}
  _objective: {fileID: 936988644}
  _hackingHud: {fileID: 314879816}
  _endScreen: {fileID: 407603336}
  _subtitles: {fileID: 121228257}
  _letterboxTop: {fileID: 2119998002}
  _letterboxBottom: {fileID: 59210728}
  _title: "\u041C\u0418\u0421\u0421\u0418\u042F 1"
  _subtitle: "\u041B\u043E\u0433\u043E\u0432\u043E \u0431\u0430\u043D\u0434\u044B"
  _objectiveText: "\u0417\u0430\u0447\u0438\u0441\u0442\u0438 \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436"
  _clearedText: "\u041B\u043E\u0433\u043E\u0432\u043E \u0437\u0430\u0447\u0438\u0449\u0435\u043D\u043E"
  _deathLines:
  - "\u042D\u0442\u043E \u043D\u0435 \u0442\u043E."
  - "\u042F \u0447\u0442\u043E-\u0442\u043E \u0443\u043F\u0443\u0441\u043A\u0430\u044E."
  - "\u0415\u0449\u0451 \u0440\u0430\u0437. \u0422\u0438\u0448\u0435."
  - "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0440\u043E\u043C\u043A\u043E."
  _menuScene: MainMenu
