  _returnText: "\u0421\u043F\u0443\u0441\u0442\u0438\u0441\u044C \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436"
  _carText: "\u0412\u0435\u0440\u043D\u0438\u0441\u044C \u043A \u043C\u0430\u0448\u0438\u043D\u0435"
