  _bloodFxPrefab: {fileID: 3303843078949948053, guid: 4aaf74fecc522194181c8f036ba46984, type: 3}
  _bloodPoolPrefab: {fileID: 6376225218116221651, guid: 1454d25959de99249b787f210a6f4293, type: 3}
  _targetLines:
  - "\u0421\u0442\u043E\u0439... \u0421\u0442\u043E\u0439! \u041A\u0442\u043E \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0441\u043B\u0430\u043B?"
  - "\u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F? \u042F \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435!"
