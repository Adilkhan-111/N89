  _corpHint: "\u041F\u0440\u043E\u0440\u0432\u0438\u0441\u044C \u0432\u043D\u0438\u0437"
  _corpText2: "\u041F\u0440\u043E\u0440\u0432\u0438\u0441\u044C \u0447\u0435\u0440\u0435\u0437 \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436"
  _corpText1: "\u041F\u0440\u043E\u0440\u0432\u0438\u0441\u044C \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436"
  _descendText: "\u0421\u043F\u0443\u0441\u0442\u0438\u0441\u044C \u043D\u0430 \u043B\u0438\u0444\u0442\u0435"
  _corpCars: []
