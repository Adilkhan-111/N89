  _dustFxPrefab: {fileID: 686343092757508598, guid: aab327bf882d97f40b0f3e8370f834c1, type: 3}
  _material: {fileID: 2100000, guid: 9dfc825aed78fcd4ba02077103263b40, type: 2}
  _cylinderPrefab: {fileID: 1684414095337579557, guid: ef646f5af28bf864e82f3d9a135533f1, type: 3}
  _dropPoints:
  - {x: 9.3, y: -76.8}
  - {x: 18, y: -76.5}
  - {x: 9.3, y: -83.7}
  - {x: 17.7, y: -83.4}
  - {x: 1.9200001, y: -82.8}
  - {x: 24.900002, y: -79.8}
  - {x: 13.8, y: -76.02}
  - {x: 10.200001, y: -88.08}
  - {x: 24.900002, y: -87.3}
  - {x: 1.5600001, y: -74.4}
  - {x: 25.2, y: -72.9}
  - {x: 17.1, y: -80.7}
  _waveSize: 3
  _waveDelay: 2
  _caseSprite: {fileID: 21300000, guid: da327eb9dbd72b04e8e3326f2754cd18, type: 3}
  _caseSize: 1.1
  _pickupRadius: 1.3
  _caseObjective: "\u0417\u0430\u0431\u0435\u0440\u0438 \u043A\u0435\u0439\u0441 \u0441 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442\u043E\u043C"
  _enterObjective: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438 \u043F\u043E\u0434\u0432\u0430\u043B"
  _fightObjective: "\u0423\u0431\u0435\u0439 \u0411\u043E\u0441\u0441\u0430"
  _pillarHint: "\u0420\u0430\u043A\u0435\u0442\u044B \u0440\u0443\u0448\u0430\u0442 \u043A\u043E\u043B\u043E\u043D\u043D\u044B \u2014 \u0437\u0430\u043C\u0430\u043D\u0438\u0442\u0435 \u0411\u043E\u0441\u0441\u0430 \u043F\u043E\u0434 \u043E\u0431\u0432\u0430\u043B"
  _gasObjective: "\u041F\u043E\u0434\u0441\u0442\u0440\u0435\u043B\u0438 \u0433\u0430\u0437\u043E\u0432\u044B\u0439 \u0431\u0430\u043B\u043B\u043E\u043D \u0440\u044F\u0434\u043E\u043C \u0441 \u0411\u043E\u0441\u0441\u043E\u043C"
  _introLines:
  - Speaker: "\u0411\u041E\u0421\u0421"
    Text: "\u0415\u0449\u0451 \u043E\u0434\u043D\u0430 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F \u0448\u0430\u0432\u043A\u0430. \u0418\u0434\u0438 \u0441\u044E\u0434\u0430."
  _finaleLines:
  - Speaker: "\u0411\u041E\u0421\u0421"
    Text: "\u0411\u0440\u0430\u0439\u0441?.. \u042F \u0434\u0443\u043C\u0430\u043B, \u0442\u044B \u043C\u0451\u0440\u0442\u0432. \u041D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u044B \u0443\u0431\u044C\u0451\u0448\u044C \u043C\u0435\u043D\u044F."
  - Speaker: "\u0420\u042D\u0419"
    Text: ...
  - Speaker: "\u0411\u041E\u0421\u0421"
    Text: "\u041F\u0440\u043E\u0449\u0430\u0439, \u043C\u043E\u0439 \u0434\u0440\u0443\u0433. \u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u043D\u0430 \u0442\u043E\u043C \u0441\u0432\u0435\u0442\u0435."
