  _implantTitle: "\u0420\u0423\u041A\u0418-\u041B\u0415\u0417\u0412\u0418\u042F"
  _implantHint: "\u041F\u041A\u041C \u2014 \u0423\u0414\u0410\u0420 \u041B\u0415\u0417\u0412\u0418\u0415\u041C   \xB7   \u041F\u041E \u041F\u0423\u041B\u0415 \u2014 \u041E\u0422\u0411\u0418\u0422\u042C"
  _stairsText: "\u0421\u043F\u0443\u0441\u0442\u0438\u0441\u044C \u0432 \u043F\u043E\u0434\u0432\u0430\u043B"
  _floor2Text: "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445, \u043A\u0440\u043E\u043C\u0435 \u0446\u0435\u043B\u0438"
  _officeText: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0446\u0435\u043B\u0438"
