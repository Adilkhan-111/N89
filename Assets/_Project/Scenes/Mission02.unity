  _heroLying: {fileID: 0}
  _heroHit: {fileID: 0}
  _exitText: "\u0412\u044B\u0439\u0434\u0438 \u0438\u0437 \u0437\u0434\u0430\u043D\u0438\u044F"
  _giveTitle: "\u041E\u041A\u041E\u041D\u0427\u0410\u0422\u0415\u041B\u042C\u041D\u0410\u042F \u0421\u041C\u0415\u0420\u0422\u042C"
  _giveSubtitle: "Relic \u0443 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438. \u0426\u0435\u043F\u043D\u043E\u0439 \u043F\u0451\u0441 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D."
  _dyingLines:
  - "\u0412\u043E\u0442 \u0438 \u0432\u0441\u0451..."
  - "\u041D\u0443 \u0447\u0442\u043E, relic... \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043D\u0430 \u0447\u0442\u043E \u0442\u044B \u0433\u043E\u0434\u0435\u043D."
