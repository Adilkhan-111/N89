  _banner: {fileID: 2007606260}
  _waypoint: {fileID: 149199224}
  _implantTitle: "\u0420\u0423\u041A\u0418-\u041B\u0415\u0417\u0412\u0418\u042F"
  _implantHint: "\u041F\u041A\u041C \u2014 \u0423\u0414\u0410\u0420 \u041B\u0415\u0417\u0412\u0418\u0415\u041C   \xB7   \u041F\u041E \u041F\u0423\u041B\u0415 \u2014 \u041E\u0422\u0411\u0418\u0422\u042C"
  _stairsText: "\u0421\u043F\u0443\u0441\u0442\u0438\u0441\u044C \u0432 \u043F\u043E\u0434\u0432\u0430\u043B"
  _floor2Text: "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445, \u043A\u0440\u043E\u043C\u0435 \u0446\u0435\u043B\u0438"
  _officeText: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0446\u0435\u043B\u0438"
  _checkpoint: mission02_basement
  _bossFight: {fileID: 1612821135}
  _target: {fileID: 0}
  _targetBody: {fileID: 0}
  _targetStanding: {fileID: 0}
  _targetDead: {fileID: 0}
  _deskPoint: {x: 0, y: 0}
  _bloodFxPrefab: {fileID: 0}
  _bloodPoolPrefab: {fileID: 0}
  _targetLines:
  - "\u0421\u0442\u043E\u0439... \u0421\u0442\u043E\u0439! \u041A\u0442\u043E \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0441\u043B\u0430\u043B?"
  - "\u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F? \u042F \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435!"
  _fader: {fileID: 1301461957}
  _objective: {fileID: 642070309}
  _hackingHud: {fileID: 1339568449}
  _endScreen: {fileID: 198809001}
  _subtitles: {fileID: 317211791}
  _letterboxTop: {fileID: 526908823}
  _letterboxBottom: {fileID: 278148226}
  _title: "\u041C\u0418\u0421\u0421\u0418\u042F 2"
  _subtitle: "\u0410\u0440\u043A\u0430 \u0421\u0438\u0441\u0442\u0435\u043C\u0441"
  _objectiveText: "\u0417\u0430\u0447\u0438\u0441\u0442\u0438 \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436"
  _clearedText: "\u041F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436 \u0437\u0430\u0447\u0438\u0449\u0435\u043D"
  _deathLines:
  - "\u042D\u0442\u043E \u043D\u0435 \u0442\u043E."
  - "\u042F \u0447\u0442\u043E-\u0442\u043E \u0443\u043F\u0443\u0441\u043A\u0430\u044E."
  - "\u0415\u0449\u0451 \u0440\u0430\u0437. \u0422\u0438\u0448\u0435."
  - "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0440\u043E\u043C\u043A\u043E."
  _menuScene: MainMenu
