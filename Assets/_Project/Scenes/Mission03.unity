  _standoffZone:
    serializedVersion: 2
    x: 303.24
    y: 5.49
    width: 11.339996
    height: 6.870001
  _standoffReaction: 0.7
  _standoffTitle: "\u041E\u041D\u0418 \u0416\u0414\u0423\u0422"
  _standoffHint: "TAB \u2014 E.N.A"
  _targetSpeaker: "\u041D\u0410\u0427\u0410\u041B\u042C\u041D\u0418\u041A"
  _targetGun: {fileID: 502479456}
  _keyItem: {fileID: 1478155462}
  _keyOffset: {x: -1, y: -0.5}
  _safe: {fileID: 1112749189}
  _safeBody: {fileID: 1112749188}
  _safeOpen: {fileID: 21300000, guid: 58f08c68825e9564bae2782105474e28, type: 3}
  _relicItem: {fileID: 1290572730}
  _pickupRadius: 0.9
  _keyText: "\u0412\u043E\u0437\u044C\u043C\u0438 \u043A\u043B\u044E\u0447 \u043E\u0442 \u0441\u0435\u0439\u0444\u0430"
  _safeText: "\u041E\u0442\u043A\u0440\u043E\u0439 \u0441\u0435\u0439\u0444"
  _relicTitle: RELIC
  _relicSubtitle: "\u041A\u041E\u041D\u0421\u0422\u0420\u0423\u041A\u0422 \u0423 \u0422\u0415\u0411\u042F"
  _relicLines:
  - ...
  - "\u0412\u043E\u0442 \u0442\u044B \u043A\u0430\u043A\u043E\u0439."
  _messenger: {fileID: 172465383}
  _bossContact: "\u0411\u041E\u0421\u0421"
  _dialogTopic: RELIC
  _dialogLines:
  - "\u0422\u044B \u0434\u043E\u0441\u0442\u0430\u043B \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E?"
  - "\u0411\u043E\u0441\u0441, \u0430 \u043A\u0435\u043C \u044F \u0431\u044B\u043B \u0434\u043E \u0432\u0441\u0435\u0433\u043E \u044D\u0442\u043E\u0433\u043E?"
  - "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u0438 \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F \u043D\u0430\u0448\u0438\u043C \u0432\u0435\u0440\u043D\u044B\u043C \u0441\u043E\u043B\u0434\u0430\u0442\u043E\u043C. \u0422\u0430\u043A \u0442\u044B \u0440\u0430\u0437\u0434\u043E\u0431\u044B\u043B \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E?"
  - "\u041C\u0435\u043D\u044F, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u0432\u0430\u043B\u0438 \u0411\u0440\u0430\u0439\u0441."
  - "\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u0440\u0430\u0437\u0434\u043E\u0431\u044B\u0442\u044C \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E \u0438 \u043E\u0442\u0434\u0430\u0442\u044C \u0435\u0451 \u043C\u043D\u0435. \u041E\u0442\u0434\u0430\u0448\u044C \u043F\u043E-\u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443?"
  _dialogFromHero: 0001000100y
  _dialogChoices:
  - "\u041E\u0442\u0434\u0430\u0442\u044C relic"
  - "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
  _corpFloor2: {fileID: 451393501}
  _corpFloor1: {fileID: 1188521712}
  _corpTitle: "\u041A\u041E\u0420\u041F\u041E\u0420\u0410\u0426\u0418\u042F \u0412 \u0417\u0414\u0410\u041D\u0418\u0418"
  _corpHint: "\u041F\u0440\u043E\u0440\u0432\u0438\u0441\u044C \u0432\u043D\u0438\u0437"
  _corpText2: "\u041F\u0440\u043E\u0440\u0432\u0438\u0441\u044C \u0447\u0435\u0440\u0435\u0437 \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436"
  _corpText1: "\u041F\u0440\u043E\u0440\u0432\u0438\u0441\u044C \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436"
  _descendText: "\u0421\u043F\u0443\u0441\u0442\u0438\u0441\u044C \u043D\u0430 \u043B\u0438\u0444\u0442\u0435"
  _corpCars:
  - {fileID: 651870699}
  - {fileID: 1631307414}
  _streetCamPoint: {fileID: 518173281}
  _corpArrivalLine: "\u0416\u0430\u043B\u044C, \u0420\u044D\u0439. \u0422\u044B \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043F\u0441\u043E\u043C."
  _heroArm: {fileID: 21300000, guid: dc6070f13cd324949a51c1f5610c3feb, type: 3}
  _heroDying: {fileID: 21300000, guid: 7df01e5b638e3c546bed42784ef68c90, type: 3}
  _exitSquad: {fileID: 76258542}
  _executioner: {fileID: 2119533538}
  _exitZone:
    serializedVersion: 2
    x: 7.5600004
    y: -1.9200001
    width: 2.1600008
    height: 1.6200001
  _insidePoint: {x: 8.64, y: 2.1000001}
  _heroLying: {fileID: 21300000, guid: 6f6a554e978a65c41ba50b6da682ae56, type: 3}
  _heroHit: {fileID: 21300000, guid: 7f675aac83d3d64408ec2acd2fb2a74e, type: 3}
  _exitText: "\u0412\u044B\u0439\u0434\u0438 \u0438\u0437 \u0437\u0434\u0430\u043D\u0438\u044F"
  _giveTitle: "\u041E\u041A\u041E\u041D\u0427\u0410\u0422\u0415\u041B\u042C\u041D\u0410\u042F \u0421\u041C\u0415\u0420\u0422\u042C"
  _giveSubtitle: "Relic \u0443 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438. \u0426\u0435\u043F\u043D\u043E\u0439 \u043F\u0451\u0441 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D."
  _dyingLines:
  - "\u0412\u043E\u0442 \u0438 \u0432\u0441\u0451..."
  - "\u041D\u0443 \u0447\u0442\u043E, relic... \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043D\u0430 \u0447\u0442\u043E \u0442\u044B \u0433\u043E\u0434\u0435\u043D."
  _endingScene: Ending
  _upperFloors:
