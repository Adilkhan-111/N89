  - BladeArms
  _armImplantTitles:
  - "\u0420\u0423\u041A\u0418 \u0413\u041E\u0420\u0418\u041B\u041B\u042B"
  - "\u0420\u0423\u041A\u0418-\u041B\u0415\u0417\u0412\u0418\u042F"
  _armImplantHints:
  - "\u041F\u041A\u041C \u2014 \u0420\u042B\u0412\u041E\u041A \u0421 \u0423\u0414\u0410\u0420\u041E\u041C   \xB7   \u0417\u0410\u0416\u0410\u0422\u042C \u041F\u041A\u041C \u2014 \u0411\u041B\u041E\u041A"
  - "\u041F\u041A\u041C \u2014 \u0423\u0414\u0410\u0420 \u041B\u0415\u0417\u0412\u0418\u0415\u041C   \xB7   \u041F\u041E \u041F\u0423\u041B\u0415 \u2014 \u041E\u0422\u0411\u0418\u0422\u042C"
  _stairsText: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0441\u044C \u043D\u0430 \u043B\u0438\u0444\u0442\u0435"
  _floor2Text: "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445, \u043A\u0440\u043E\u043C\u0435 \u0446\u0435\u043B\u0438"
  _officeText: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0446\u0435\u043B\u0438"
  _checkpoint: mission03_floor2
  _bossFight: {fileID: 0}
  _target: {fileID: 0}
  _targetBody: {fileID: 0}
  _targetStanding: {fileID: 0}
  _targetDead: {fileID: 0}
  _deskPoint: {x: 0, y: 0}
  _bloodFxPrefab: {fileID: 0}
  _bloodPoolPrefab: {fileID: 0}
  _targetLines:
  - "\u0421\u0442\u043E\u0439... \u0421\u0442\u043E\u0439! \u041A\u0442\u043E \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0441\u043B\u0430\u043B?"
  - "\u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F? \u042F \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435!"
